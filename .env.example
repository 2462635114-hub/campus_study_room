# ============================================================================
# 环境变量示例文件
# 使用方法：复制为 .env 并按需修改；不要把真实 .env 提交到版本库。
# ============================================================================

# Flask 配置：development / testing / production
FLASK_CONFIG=development

# 是否开启调试模式（仅本地开发使用 1）
FLASK_DEBUG=1

# 会话与 CSRF 签名密钥：生产环境必须替换为强随机值，例如：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# 数据库连接（默认使用 instance/campus.db，一般无需设置）
# 如需自定义位置请填写绝对路径：SQLite 相对路径会基于 Flask 的 instance 目录解析。
# DATABASE_URL=sqlite:///C:/path/to/campus.db

# 预约业务规则
BOOKING_WINDOW_DAYS=30

# 生产环境启用后，Session Cookie 只通过 HTTPS 传输（本地 HTTP 开发请保持 0）
SESSION_COOKIE_SECURE=0

# 演示/初始化密码（可选）。不设置时，初始化命令会生成随机密码并只打印一次。
# 仅用于本地开发，禁止在生产环境使用弱密码。
# DEMO_ADMIN_USERNAME=admin
# DEMO_ADMIN_PASSWORD=
# DEMO_STUDENT_PASSWORD=
